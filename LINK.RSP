# =========================================================
# LINK.RSP — Edition de liens 32 bits (DOS/32A, format LE)
# =========================================================
# Directives explicites (equivalentes au systeme "stub32a" de
# dos32a.lnk) plutot qu'un simple "SYSTEM STUB32A" : evite de
# dependre de l'enregistrement de dos32a.lnk dans la base de
# systemes de VOTRE installation Watcom 1.9 (voir
# PORTAGE_32BITS.md). Si vous avez correctement installe
# dos32a.lnk (systeme "STUB32A" reconnu par wlink), vous
# pouvez remplacer tout ce bloc par la seule ligne :
#   SYSTEM STUB32A
#
# STUB32A.EXE et DOS32A.EXE doivent se trouver dans le meme
# repertoire que demo.exe (ou dans le PATH) au lancement.
# =========================================================

LIBPATH %WATCOM%\LIB386
LIBPATH %WATCOM%\LIB386\DOS
LIBPATH %WATCOM%\LIB386\L32
OPTION STUB=stub32a.exe
FORMAT OS2 LE

file main.obj
file timer.obj
file keyboard.obj
file video.obj
file palette.obj
file graphics.obj
file image.obj
file sprite.obj
file font1.obj
file f1_8x8.obj
file f1_8x16.obj
file f1_16x16.obj
file font2.obj
file sblaster.obj
file s3m.obj
file wav.obj
file audio.obj
file scene.obj
file scene0.obj
file scene1.obj
file scene2.obj
file scene3.obj
file scene4.obj
file scene5.obj
file scene6.obj
file scene7.obj
file scene8.obj
name demo.exe
